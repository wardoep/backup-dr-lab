# Copy to restic.env and fill in.  restic.env is gitignored — NEVER commit real values.
# Source it before running restic by hand:  set -a; . ./restic.env; set +a

# --- Repository location ---
# Local external disk:
export RESTIC_REPOSITORY="/mnt/backup/restic-repo"
# ...or offsite S3-compatible (uncomment and set the AWS_* below instead):
# export RESTIC_REPOSITORY="s3:https://s3.example.com/my-backup-bucket"

# --- Encryption password ---
# Prefer a password FILE with 0600 perms over an inline password.
export RESTIC_PASSWORD_FILE="/root/.restic-password"
# (Alternatively, and less safely: export RESTIC_PASSWORD="...")

# --- Offsite (S3) credentials, only if RESTIC_REPOSITORY is s3:* ---
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."

# --- What to back up (space-separated absolute paths) ---
export BACKUP_PATHS="/etc /srv /home/eddie/important /var/lib/docker/volumes"

# --- Excludes file (one glob per line), optional ---
export BACKUP_EXCLUDES_FILE="/home/eddie/backup-dr-lab/scripts/excludes.txt"

# --- Retention policy ---
export KEEP_DAILY=7
export KEEP_WEEKLY=4
export KEEP_MONTHLY=6

# --- A tag applied to snapshots from this host ---
export BACKUP_TAG="homelab"
